<?xml version="1.0"?>
<!--
  Companion module for StripeIntegration_Payments: lets an agentic-commerce
  platform's Stripe Shared Payment Token (spt_…) pay for a Magento order
  through the stock placeOrder flow. See README.md.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_StripeSharedPaymentTokens">
        <sequence>
            <module name="StripeIntegration_Payments"/>
        </sequence>
    </module>
</config>
